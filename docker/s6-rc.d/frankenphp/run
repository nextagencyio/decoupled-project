#!/bin/sh
# s6-overlay longrun service: FrankenPHP + Caddy worker.
#
# Runs as root (matches the dunglas/frankenphp base image's default).
# Reads its config from /etc/frankenphp/Caddyfile which we COPY in
# from the project root. The Caddyfile's frankenphp block enables
# worker mode against /app/frankenphp-worker.php.
#
# Depends on mariadb-ready (in dependencies.d/) so s6 waits for
# mariadbd to accept pings before starting this service. That
# prevents the Drupal container from trying to open a PDO
# connection before mariadbd is actually listening.
exec 2>&1
exec /usr/local/bin/frankenphp run --config /etc/frankenphp/Caddyfile --adapter caddyfile
