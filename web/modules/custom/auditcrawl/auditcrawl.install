<?php

/**
 * @file
 * Install / uninstall hooks for the AuditCrawl module.
 */

/**
 * Implements hook_install().
 *
 * We prefer to reuse the stock 'article' content type if it's
 * already present — customers usually have it and our drafts live
 * alongside their other posts. If article DOESN'T exist, we don't
 * create it silently here — instead the first visit to
 * /admin/content/auditcrawl routes through SetupForm which asks the admin
 * for consent before creating content-type-scale config.
 */
function auditcrawl_install() {
  if (\Drupal\node\Entity\NodeType::load('article')) {
    \Drupal\auditcrawl\Service\NodeWriter::installFields();
  }
}

/**
 * Implements hook_uninstall().
 *
 * We deliberately do NOT delete the 'article' content type, nodes,
 * or our custom fields on uninstall — a customer might reinstall
 * to pick up existing drafts, and article may belong to other
 * content the customer cares about.
 */
function auditcrawl_uninstall() {
  \Drupal::configFactory()->getEditable('auditcrawl.settings')->delete();
}
