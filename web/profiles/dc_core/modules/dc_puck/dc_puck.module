<?php

/**
 * @file
 * Overrides the Edit tab to launch the Puck visual editor for supported nodes.
 */

use Drupal\Core\Url;

/**
 * Implements hook_entity_operation_alter().
 *
 * Replaces the Edit operation URL with the Puck editor URL for nodes
 * that have a field_puck_data field.
 */
function dc_puck_entity_operation_alter(array &$operations, \Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'node' || !$entity->hasField('field_puck_data')) {
    return;
  }

  $puck_url = \Drupal::state()->get('dc_puck.editor_url', '');
  if (empty($puck_url)) {
    return;
  }

  if (isset($operations['edit'])) {
    $operations['edit']['url'] = Url::fromUri($puck_url . '/editor/' . $entity->id());
  }
}

/**
 * Implements hook_local_tasks_alter().
 *
 * Changes the Edit tab to point to the Puck editor for nodes with puck_data.
 */
function dc_puck_menu_local_tasks_alter(&$data, $route_name, &$cacheability) {
  // Only alter on node pages.
  if (!in_array($route_name, ['entity.node.canonical', 'entity.node.edit_form'])) {
    return;
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node || !$node->hasField('field_puck_data')) {
    return;
  }

  $puck_url = \Drupal::state()->get('dc_puck.editor_url', '');
  if (empty($puck_url)) {
    return;
  }

  // Override the Edit tab URL to point to Puck editor.
  if (isset($data['tabs'][0]['entity.node.edit_form'])) {
    $data['tabs'][0]['entity.node.edit_form']['#link']['url'] = Url::fromUri($puck_url . '/editor/' . $node->id());
  }

  // Ensure cache varies per node.
  $cacheability->addCacheContexts(['route']);
}
