{
	# Disable auto-HTTPS — Railway terminates TLS at its proxy.
	auto_https off
	# Disable the Caddy admin API — we don't need it in production.
	admin off
	# Required so Caddy knows where in the handler chain php_server goes
	# when it's used inside a route block.
	order php_server before file_server

	# PHP concurrency. Drupal requests go through php_server to index.php,
	# which runs on FrankenPHP's REGULAR threads, not the worker below: the
	# worker only serves requests for frankenphp-worker.php itself. Regular
	# threads = num_threads - workers, and num_threads defaults to 2x CPUs.
	# On a 1-CPU tenant that left ONE thread, so every PHP request queued
	# behind the one before it. Drupal Canvas setup deadlocked on it: Drupal
	# calls the frontend's /api/canvas/components, the frontend redeems the
	# preview assertion against Drupal, and that callback waited behind the
	# request that made it until both timed out (found 2026-09-30 on the
	# first real Canvas provision; DDEV's php-fpm pool hid it).
	# FRANKENPHP_THREADS / FRANKENPHP_WORKERS override the defaults.
	frankenphp {
		num_threads {$FRANKENPHP_THREADS:8}
		worker /app/frankenphp-worker.php {$FRANKENPHP_WORKERS:1}
	}
}

# Railway injects PORT. Local docker-run defaults to 8080.
:{$PORT:8080} {
	root * /app/web
	encode zstd br gzip

	# php_server handles Drupal's index.php + static file routing.
	# With the worker block above configured in the global section,
	# php_server will automatically route PHP requests to the worker pool
	# instead of spawning a fresh process per request.
	php_server

	log {
		output stdout
		format json
	}
}
